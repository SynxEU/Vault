@page "/"
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<PageTitle>Vault - Secure Banking</PageTitle>

<div class="hero-section">
    <div class="container text-center py-5">
        <h1 class="display-3 fw-bold">VAULT</h1>
        <p class="lead fs-4 mb-5">Secure Bank Account Management System</p>
        
        @if (IsAuthenticated)
        {
            <div class="mb-4">
                <p class="fs-5">Welcome, <strong>@Username</strong>!</p>
                <p class="text-white-50">Email: @Email</p>
            </div>
            <a href="/accounts" class="btn btn-light btn-lg me-3 fw-bold">
                <i class="bi bi-safe2"></i> My Accounts
            </a>
            <a href="/register" class="btn btn-outline-light btn-lg fw-bold">
                <i class="bi bi-info-circle"></i> About
            </a>
        }
        else
        {
            <RadzenButton Text="Login" Click="@( () => Navigation.NavigateTo("/login"))" Style="margin-right:8px" />
            <RadzenButton Text="Create Account" ButtonStyle="ButtonStyle.Secondary" Click="@( () => Navigation.NavigateTo("/register"))" />
        }
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <div class="col-lg-4 col-md-6 mb-4">
            <RadzenCard Style="height:100%">
                <div style="font-weight:700;margin-bottom:8px;">Bank-Grade Security</div>
                <p>All sensitive data including account numbers, balances, and transactions are encrypted using military-grade AES-256 encryption. Your data is protected even if our servers are compromised.</p>
            </RadzenCard>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <RadzenCard Style="height:100%">
                <div style="font-weight:700;margin-bottom:8px;">Secure Passwords</div>
                <p>Passwords are hashed with BCrypt (workfactor 12), ensuring your login credentials are never stored in plain text. We also use PBKDF2 for key derivation.</p>
            </RadzenCard>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <RadzenCard Style="height:100%">
                <div style="font-weight:700;margin-bottom:8px;">Full Control</div>
                <p>Manage multiple bank accounts, track transactions, update balances, and organize your finances all in one secure place with an intuitive interface.</p>
            </RadzenCard>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="text-center mb-4 fw-bold">Security Features</h2>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0 me-3">
                            <span class="badge bg-primary rounded-circle p-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-check-lg"></i>
                            </span>
                        </div>
                        <div>
                            <h5>AES-256 Encryption</h5>
                            <small class="text-muted">All account details encrypted</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0 me-3">
                            <span class="badge bg-primary rounded-circle p-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-check-lg"></i>
                            </span>
                        </div>
                        <div>
                            <h5>BCrypt Hashing</h5>
                            <small class="text-muted">Strong password protection</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0 me-3">
                            <span class="badge bg-primary rounded-circle p-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-check-lg"></i>
                            </span>
                        </div>
                        <div>
                            <h5>Random IV Generation</h5>
                            <small class="text-muted">Unique for each encryption</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0 me-3">
                            <span class="badge bg-primary rounded-circle p-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-check-lg"></i>
                            </span>
                        </div>
                        <div>
                            <h5>PBKDF2 Key Derivation</h5>
                            <small class="text-muted">10,000 iterations, SHA-256</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool IsAuthenticated = false;
    private string? Username;
    private string? Email;

    protected override void OnInitialized()
    {
        var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
        Username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
        Email = HttpContextAccessor.HttpContext?.Session.GetString("Email");
        IsAuthenticated = userId.HasValue && userId > 0;
    }
}

