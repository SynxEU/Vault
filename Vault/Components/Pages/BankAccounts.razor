@page "/accounts"

@using System.Security.Claims
@using Vault.Domain.Entities.Enums

@inject NotificationService NotificationService
@inject IBankAccountService BankAccountService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@rendermode InteractiveServer

<PageTitle>My Accounts - Vault</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        <div class="hero-section py-4">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="text-white mb-0">
                            My Accounts
                        </h2>
                        <small class="text-white-50">
                            Manage your bank accounts securely
                        </small>
                    </div>
                    <RadzenButton Text="Add Account"
                                  Click="ShowCreateForm"
                                  ButtonStyle="ButtonStyle.Light" />
                </div>
            </div>
        </div>

        <div class="container py-5">
            @if (ShowCreate)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="mb-4">
                            <i class="bi bi-plus-circle"></i>
                            Add New Bank Account
                        </h5>
                        
                        <EditForm Model="@NewAccount"
                                  OnValidSubmit="@HandleCreateAccount">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Account Name
                                    </label>
                                    <InputText class="form-control"
                                               @bind-Value="NewAccount.AccountName" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Account Type
                                    </label>
                                    <InputSelect class="form-select"
                                                 @bind-Value="NewAccount.AccountType">
                                        @foreach(var type in Enum.GetValues<AccountType>())
                                        {
                                            <option value="@type">
                                                @type
                                            </option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Bank Name
                                    </label>
                                    <InputText class="form-control"
                                               @bind-Value="NewAccount.BankName" />
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Currency
                                    </label>
                                    <InputText class="form-control"
                                               @bind-Value="NewAccount.Currency" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Account Number
                                    </label>
                                    <InputText class="form-control"
                                               @bind-Value="NewAccount.AccountNumber" />
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        IBAN
                                    </label>
                                    <InputText class="form-control"
                                               @bind-Value="NewAccount.IBAN" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Registration Number
                                    </label>
                                    <InputText class="form-control"
                                               @bind-Value="NewAccount.RegistrationNumber" />
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Initial Balance
                                    </label>
                                    <InputNumber class="form-control"
                                                 @bind-Value="NewAccount.Balance" />
                                </div>
                            </div>
                            <RadzenButton ButtonType="ButtonType.Submit"
                                          Text="Create Account"
                                          ButtonStyle="ButtonStyle.Primary" />
                            <RadzenButton Text="Cancel"
                                          Click="CancelCreate"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          class="ms-2" />
                        </EditForm>
                    </div>
                </div>
            }
            
            @if (Accounts?.Count > 0)
            {
                <div class="row">
                    @foreach(var account in Accounts)
                    {
                        <div class="col-md-6 mb-4">
                            <RadzenCard>
                                <h5>
                                    @account.AccountName
                                </h5>
                                <p>
                                    <strong>
                                        Type:
                                    </strong>
                                    @account.AccountType
                                </p>
                                <p class="text-muted">
                                    Created:
                                    @account.CreatedAt.ToString("dd/MM/yyyy")
                                </p>
                                <RadzenButton Size="ButtonSize.Small"
                                              Text="Open Account"
                                              Click="@(() => OpenAccount(account.Id))" />
                                <RadzenButton Size="ButtonSize.Small"
                                              Text="Delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              class="ms-2"
                                              Click="@(() => DeleteAccount(account.Id))" />
                            </RadzenCard>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No bank accounts yet.
                    <button class="btn btn-link p-0"
                            @onclick="ShowCreateForm">
                        Create one now
                    </button>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-5">
            <div class="alert alert-warning">
                Please
                <a href="/login">
                    login
                </a>
                to access your accounts.
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private Guid? UserId;
    private List<BankAccountDto> Accounts = new();
    private CreateBankAccountRequest NewAccount = new();
    private bool ShowCreate;
    
    protected override async Task OnInitializedAsync()
    {
        var state =
            await AuthenticationStateTask;
        
        var idClaim =
            state.User.FindFirst(
                ClaimTypes.NameIdentifier);
        
        if(idClaim != null &&
           Guid.TryParse(idClaim.Value,out var id))
        {
            UserId = id;
        }
        
        if(UserId.HasValue)
        {
            await LoadAccounts();
        }
    }
    
    private async Task LoadAccounts()
    {
        if(!UserId.HasValue)
            return;
        
        var response =
            await BankAccountService.GetAllAccountsAsync(
                UserId.Value);
        
        if(response.Success)
        {
            Accounts =
                response.Data ?? new();
        }
        else
        {
            ShowError(response.Message);
        }
    }
    
    private void ShowCreateForm()
    {
        ShowCreate = !ShowCreate;
    }
    
    private void CancelCreate()
    {
        ShowCreate = false;
        NewAccount = new();
    }
    
    private async Task HandleCreateAccount()
    {
        if(!UserId.HasValue)
            return;
        
        var response =
            await BankAccountService.CreateAccountAsync(
                UserId.Value,
                NewAccount);

        if(response.Success)
        {
            await LoadAccounts();
            NewAccount = new();
            ShowCreate = false;
            ShowSuccess("Account created successfully");
        }
        else
        {
            ShowError(response.Message);
        }
    }

    private void OpenAccount(Guid id)
    {
        Navigation.NavigateTo(
            $"/accounts/{id}");
    }
    
    private async Task DeleteAccount(Guid id)
    {
        if(!UserId.HasValue)
            return;
        
        if(await JS.InvokeAsync<bool>(
            "confirm",
            "Delete account?"))
        {
            var response =
                await BankAccountService.DeleteAccountAsync(
                    UserId.Value,
                    id);
            
            if(response.Success)
            {
                await LoadAccounts();
                ShowSuccess(
                    "Account deleted");
            }
            else
            {
                ShowError(response.Message);
            }
        }
    }
    
    private void ShowError(string message)
    {
        NotificationService.Notify(
            NotificationSeverity.Error,
            "Error",
            message,
            4000);
    }
    
    private void ShowSuccess(string message)
    {
        NotificationService.Notify(
            NotificationSeverity.Success,
            "Success",
            message,
            4000);
    }
}