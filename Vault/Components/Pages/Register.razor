@page "/register"
@inject IAuthenticationService AuthService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@rendermode InteractiveServer

<PageTitle>Register - Vault</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container py-5">
            <div class="alert alert-info text-center">
                You are already logged in.
                <br />
                Redirecting to home...
            </div>
        </div>
    </Authorized>
    
    <NotAuthorized Context="auth">
        <div class="hero-section">
            <div class="container text-center py-5">
                <h1>
                    VAULT
                </h1>
                <p class="lead">
                    Secure Banking System
                </p>
            </div>
        </div>
        
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-5 col-md-6">
                    <div class="card shadow">
                        <div class="card-body p-5">
                            <h2 class="card-title text-center mb-4">
                                Create Account
                            </h2>
                            
                            <EditForm Model="RegisterRequest"
                                      OnValidSubmit="HandleRegister">
                                <DataAnnotationsValidator />
                                <div class="mb-3">
                                    <label class="form-label">
                                        Username
                                    </label>
                                    <InputText class="form-control form-control-lg"
                                               @bind-Value="RegisterRequest.Username" />
                                    <ValidationMessage For="@(() => RegisterRequest.Username)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        Email
                                    </label>
                                    <InputText type="email"
                                               class="form-control form-control-lg"
                                               @bind-Value="RegisterRequest.Email" />
                                    <ValidationMessage For="@(() => RegisterRequest.Email)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        Password
                                    </label>
                                    <InputText type="password"
                                               class="form-control form-control-lg"
                                               @bind-Value="RegisterRequest.Password" />
                                    <ValidationMessage For="@(() => RegisterRequest.Password)" />
                                </div>
                                
                                <div class="mb-4">
                                    <label class="form-label">
                                        Confirm Password
                                    </label>
                                    <InputText type="password"
                                               class="form-control form-control-lg"
                                               @bind-Value="RegisterRequest.ConfirmPassword" />
                                    <ValidationMessage For="@(() => RegisterRequest.ConfirmPassword)" />
                                </div>
                                
                                <RadzenButton id="create-account-button"
                                              ButtonType="ButtonType.Submit"
                                              Text="Create Account"
                                              Icon="person_add"
                                              Disabled="@IsBusy"
                                              IsBusy="@IsBusy"
                                              BusyText="Creating..."
                                              Style="width:100%" />
                            </EditForm><hr />
                            
                            <p class="text-center text-muted">
                                Already have an account?
                            </p>
                            
                            <RadzenButton Text="Login"
                                          Variant="Variant.Text"
                                          Click="@GoToLogin" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code
{
    private readonly RegisterRequest RegisterRequest = new();
    private bool IsBusy;
    
    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if(authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", true);
        }
    }
    
    private async Task HandleRegister()
    {
        if(IsBusy)
            return;
        IsBusy = true;
        var response =
            await AuthService.RegisterAsync(RegisterRequest);
        
        if(!response.Success)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Registration Failed",
                response.Message ?? "Registration failed."
            );
            IsBusy = false;
            return;
        }
        
        NotificationService.Notify(
            NotificationSeverity.Success,
            "Success",
            "Account created successfully."
        );
        
        await Task.Delay(1500);
        
        Navigation.NavigateTo("/login");

    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}