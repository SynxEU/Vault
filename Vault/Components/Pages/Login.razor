@page "/login"
@using Vault.Service.DTOs

@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Login</PageTitle>

<div class="hero-section">
    <div class="container text-center py-5">
        <h1>VAULT</h1>
        <p class="lead">Secure Banking System</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        Welcome Back
                    </h2>
                    <EditForm
                        Model="_model"
                              OnValidSubmit="@HandleLogin"
                              FormName="Login">
                        <DataAnnotationsValidator />
                        <div class="mb-4">
                            <label class="form-label">
                                Username
                            </label>
                            <InputText class="form-control form-control-lg"
                                       @bind-Value="_model.Username"
                                       placeholder="Enter your username" />
                            <ValidationMessage For="@(() => _model.Username)"
                                               class="text-danger" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label">
                                Password
                            </label>
                            <InputText type="password"
                                       class="form-control form-control-lg"
                                       @bind-Value="_model.Password"
                                       placeholder="Enter your password" />

                            <ValidationMessage For="@(() => _model.Password)"
                                               class="text-danger" />
                        </div>
                        <RadzenButton ButtonType="ButtonType.Submit"
                                      Text="Login"
                                      Icon="login"
                                      Style="width:100%" />
                    </EditForm>
                    <hr />
                    <p class="text-center text-muted mb-0">
                        Don't have an account?
                        <a href="/register"
                           class="fw-bold text-decoration-none">
                            Sign up here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    
    [SupplyParameterFromForm]
    private LoginRequest _model { get; set; } = new();
    
    private async Task HandleLogin()
    {
        Console.WriteLine($"Username: {_model.Username}");
        Console.WriteLine($"Password: {_model.Password}");
        
        AuthResponse response = await AuthService.LoginAsync(_model);
        
        if(response.Success)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Login failed",
                 response.Message ?? "Failed",
                closeOnClick: true);
        }

    }

}