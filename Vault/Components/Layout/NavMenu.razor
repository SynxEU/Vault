@rendermode InteractiveServer

@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm px-3">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold fs-4"
           href="/">
            Vault
        </a>
        <div class="d-flex align-items-center gap-2">
            <RadzenButton Text="Home"
                          Icon="home"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@GoHome" />
            <AuthorizeView>
                <Authorized>
                    <RadzenButton Text="My Accounts"
                                  Icon="account_balance"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GoAccounts" />
                    <span class="text-white fw-semibold px-2">
                        @context.User.Identity?.Name
                    </span>
                    <RadzenButton Text="Logout"
                                  Icon="logout"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@Logout" />
                </Authorized>
                <NotAuthorized>
                    <RadzenButton Text="Login"
                                  Icon="login"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@GoLogin" />
                    <RadzenButton Text="Register"
                                  Icon="person_add"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GoRegister" />
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
    private void GoAccounts()
    {
        Navigation.NavigateTo("/accounts");
    }
    private void GoLogin()
    {
        Navigation.NavigateTo("/login");
    }
    private void GoRegister()
    {
        Navigation.NavigateTo("/register");
    }
    private void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }
}