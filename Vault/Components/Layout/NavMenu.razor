@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<div style="background:#212529;color:white;padding:0.5rem 1rem;display:flex;align-items:center;justify-content:space-between;">
    <div style="font-weight:700;font-size:1.25rem">Vault</div>
    <div>
        <RadzenButton Text="Home" Style="margin-right:8px" Click="@( () => Navigation.NavigateTo("/"))" />
        @if (IsAuthenticated)
        {
            <RadzenButton Text="My Accounts" Style="margin-right:8px" Click="@( () => Navigation.NavigateTo("/accounts"))" />
            <span style="margin-right:8px">@Username</span>
            <RadzenButton Text="Logout" ButtonStyle="ButtonStyle.Light" Click="Logout" />
        }
        else
        {
            <RadzenButton Text="Login" Style="margin-right:8px" Click="@( () => Navigation.NavigateTo("/login"))" />
            <RadzenButton Text="Register" Click="@( () => Navigation.NavigateTo("/register"))" />
        }
    </div>
</div>

@code {
    private bool IsAuthenticated = false;
    private string? Username;

    protected override void OnInitialized()
    {
        var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
        Username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
        IsAuthenticated = userId.HasValue && userId > 0;
    }

    private void Logout()
    {
        HttpContextAccessor.HttpContext?.Session.Clear();
        Navigation.NavigateTo("/");
    }
}

